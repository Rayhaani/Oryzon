/* ============================================================
   PAGES.CSS — Nexus Pages (SPA: loaded by router.js, own file)
   Brand: black #050505 + the official post-header gold.
   ============================================================ */
html.pg-loading #headerTitleText { visibility: hidden; }

:root {
  --bg-void: #050505;
  --glass-border: rgba(255, 255, 255, 0.08);
  --neon-cyan: #fde08d;
  --gold: #E3C48D;
  --gold-deep: #B8860B;
  --text-main: #f4f5f7;
  --text-sub: #9aa0ab;
  --danger: #ef4444;
  --pg-line: rgba(255,255,255,0.07);
}
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { overflow-y: auto; }
body {
  background: #050505 !important; background-image: none !important; color: #fff;
  font-family: 'Plus Jakarta Sans', 'Inter', sans-serif; margin: 0; padding: 0 0 40px; overflow-x: hidden;
}
body.a11y-text-small .post-content { font-size: 0.88em !important; }
body.a11y-text-large .post-content { font-size: 1.18em !important; }
a { color: inherit; text-decoration: none; }
button { font-family: inherit; }
.verified-badge { color: #1d9bf0; font-size: 13px; }

/* ================= HEADER (unchanged) ================= */
/* ================= HEADER ================= */
header {
    position: fixed; top: 0; left: 0; width: 100%; height: 56px;
    background: transparent;
    backdrop-filter: none;
    border-bottom: 1px solid transparent;
    display: flex; align-items: center; padding: 0 12px; gap: 10px;
    z-index: 9999; box-sizing: border-box;
    transition: background 0.25s ease, backdrop-filter 0.25s ease, border-color 0.25s ease;
}
header.header-scrolled {
    background: linear-gradient(180deg, rgba(5,5,5,0.95) 0%, rgba(5,5,5,0.85) 65%, rgba(5,5,5,0.35) 100%);
    backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--glass-border);
}

.fb-back-btn {
    width: 34px; height: 34px; border-radius: 50%; flex-shrink: 0;
    background: rgba(0, 0, 0, 0.35); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.15);
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 15px; cursor: pointer;
}
.fb-header-title {
    font-size: 15px; font-weight: 800; color: #fff;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 1; min-width: 0;
    opacity: 0;
    transition: opacity 0.25s ease;
    display: flex; align-items: center; gap: 5px;
}
header.header-scrolled .fb-header-title { opacity: 1; }

.header-actions { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
.header-icon-btn {
    width: 36px; height: 36px;
    background: rgba(0,0,0,0.35); backdrop-filter: blur(8px);
    border: 1px solid rgba(255,255,255,0.15);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 15px;
    cursor: pointer; flex-shrink: 0;
}
.header-icon-btn:active { background: rgba(253,224,141,0.2); }
@keyframes dotSequence {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.4); opacity: 1; }
}

/* ================= PAGE VIEW ================= */
#pageView { min-height: 100vh; display: flex; flex-direction: column; }

.pg-cover { position: relative; width: 100%; height: 178px; overflow: hidden; background:
  linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.18) 55%, rgba(0,0,0,0) 78%),
  radial-gradient(ellipse 90% 140% at 48% 0%, #F8D9A2 0%, #E3C48D 22%, #C09060 50%, #A77542 72%, #8B5B2D 100%); }
.pg-cover::before { content: ''; position: absolute; inset: 0; background: inherit; filter: brightness(0.7); }
.pg-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
.pg-cover-fade { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(5,5,5,0.35) 0%, rgba(5,5,5,0) 30%, rgba(5,5,5,0) 62%, #050505 100%); }

.pg-idrow { display: flex; align-items: flex-end; justify-content: space-between; gap: 12px; padding: 0 16px; margin-top: -42px; position: relative; z-index: 3; }
/* gold crescent avatar — same construction as every avatar in Nexus */
.pg-av { width: 92px; height: 92px; padding: 4.4px; border-radius: 50%; flex-shrink: 0; background: linear-gradient(135deg, #fde08d, #b8860b); box-shadow: 0 6px 18px rgba(0,0,0,0.55); }
.pg-av img { display: block; width: 100%; height: 100%; box-sizing: content-box; border: 4.4px solid #050505; border-radius: 50%; background: #262626; object-fit: cover; }
.pg-actions { display: flex; align-items: center; gap: 8px; padding-bottom: 4px; min-height: 40px; }

.pg-btn { height: 38px; padding: 0 18px; border-radius: 11px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; font-size: 13.5px; font-weight: 700; color: #fff; cursor: pointer; border: 0; white-space: nowrap; position: relative; isolation: isolate; transition: transform .12s, opacity .12s; }
.pg-btn:active { transform: scale(0.96); }
.pg-btn.pri { background: transparent; }
.pg-btn.pri::before { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: -1; background:
  linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.18) 55%, rgba(0,0,0,0) 78%),
  url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.15'/></svg>"),
  radial-gradient(ellipse 90% 140% at 48% 0%, #F8D9A2 0%, #E3C48D 22%, #C09060 50%, #A77542 72%, #8B5B2D 100%);
  background-blend-mode: overlay, normal; filter: brightness(0.7); }
.pg-btn.sec { background: rgba(255,255,255,0.09); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1); }
.pg-btn.ico { width: 38px; padding: 0; background: rgba(255,255,255,0.09); box-shadow: inset 0 0 0 1px rgba(255,255,255,0.1); font-size: 15px; }
.pg-btn.dis { opacity: .55; pointer-events: none; }

.pg-ident { padding: 12px 16px 0; }
.pg-name { font-size: 22px; font-weight: 800; letter-spacing: -0.4px; line-height: 1.2; display: flex; align-items: center; gap: 7px; flex-wrap: wrap; color: #fff; }
.pg-name .verified-badge { font-size: 16px; }
.pg-trust { display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 700; color: var(--gold); background: rgba(227,196,141,0.1); border-radius: 20px; padding: 3px 9px; }
.pg-sub { margin-top: 4px; color: var(--text-sub); font-size: 13.5px; line-height: 1.4; }
.pg-bio { padding: 12px 16px 0; font-size: 14.5px; line-height: 1.55; color: #d9dce2; white-space: pre-line; overflow-wrap: anywhere; }
.pg-bio.clamp { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.pg-more { padding: 4px 16px 0; color: var(--gold); font-size: 13.5px; font-weight: 700; cursor: pointer; display: inline-block; }
.pg-facts { padding: 12px 16px 0; display: flex; flex-direction: column; gap: 9px; }
.pg-fact { display: flex; align-items: center; gap: 11px; font-size: 14px; color: #cfd3da; min-width: 0; }
.pg-fact i { width: 16px; text-align: center; color: var(--text-sub); font-size: 13.5px; flex-shrink: 0; }
.pg-fact span, .pg-fact a { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
.pg-fact a { color: var(--gold); font-weight: 600; }

.pg-stats { display: flex; margin: 18px 16px 0; border-top: 1px solid var(--pg-line); border-bottom: 1px solid var(--pg-line); }
.pg-stat { flex: 1; text-align: center; padding: 13px 4px 12px; cursor: default; }
.pg-stat + .pg-stat { border-left: 1px solid var(--pg-line); }
.pg-stat b { display: block; font-size: 18px; font-weight: 800; letter-spacing: -0.3px; color: #fff; }
.pg-stat small { display: block; margin-top: 2px; font-size: 11.5px; color: var(--text-sub); font-weight: 600; }
.pg-stat.tap { cursor: pointer; }

.pg-hl { display: flex; gap: 14px; overflow-x: auto; padding: 16px 16px 2px; scrollbar-width: none; }
.pg-hl::-webkit-scrollbar { display: none; }
.pg-hl-item { flex-shrink: 0; width: 66px; text-align: center; cursor: pointer; }
.pg-hl-ring { width: 66px; height: 66px; padding: 2.5px; border-radius: 50%; background: linear-gradient(135deg, #fde08d, #b8860b); }
.pg-hl-ring img { display: block; width: 100%; height: 100%; box-sizing: content-box; border: 2.5px solid #050505; border-radius: 50%; object-fit: cover; background: #262626; }
.pg-hl-item small { display: block; margin-top: 6px; font-size: 11.5px; color: #d9dce2; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

/* ================= TABS (sticky) ================= */
.pg-tabs { position: sticky; top: 56px; z-index: 200; display: flex; overflow-x: auto; margin-top: 18px; padding: 0 8px; background: #050505; border-bottom: 1px solid var(--pg-line); scrollbar-width: none; }
.pg-tabs::-webkit-scrollbar { display: none; }
.ptab { flex-shrink: 0; padding: 13px 14px 12px; font-size: 14px; font-weight: 700; color: var(--text-sub); position: relative; cursor: pointer; white-space: nowrap; }
.ptab.active { color: #fff; }
.ptab.active::after { content: ''; position: absolute; left: 10px; right: 10px; bottom: -1px; height: 3px; border-radius: 3px 3px 0 0; background: linear-gradient(135deg, #fde08d, #b8860b); }
.tab-panel { display: none; min-height: 50vh; }
.tab-panel.active { display: block; }
#timeline-area { padding-top: 12px; display: flex; flex-direction: column; }

/* composer (owner) */
.pg-composer { display: flex; align-items: center; gap: 12px; margin: 12px 14px 2px; padding: 11px 12px; border-radius: 16px; background: rgba(255,255,255,0.05); box-shadow: inset 0 0 0 1px var(--pg-line); cursor: pointer; }
.pg-composer .cav { width: 36px; height: 36px; border-radius: 50%; object-fit: cover; background: #262626; flex-shrink: 0; }
.pg-composer span { flex: 1; color: var(--text-sub); font-size: 14.5px; }
.pg-composer i { color: var(--gold); font-size: 17px; }

/* empty + skeleton */
.pg-empty { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 56px 36px; gap: 8px; }
.pg-empty .ei { width: 64px; height: 64px; border-radius: 20px; background: rgba(227,196,141,0.08); color: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 24px; margin-bottom: 8px; }
.pg-empty b { font-size: 16px; font-weight: 700; }
.pg-empty p { color: var(--text-sub); font-size: 13.5px; line-height: 1.5; }
.pg-empty .pg-btn { margin-top: 12px; }
.pg-sk { margin: 14px; border-radius: 18px; height: 220px; background: linear-gradient(100deg, rgba(255,255,255,0.04) 30%, rgba(255,255,255,0.09) 50%, rgba(255,255,255,0.04) 70%); background-size: 200% 100%; animation: pgShim 1.3s infinite linear; }
.pg-sk.s { height: 64px; }
@keyframes pgShim { from { background-position: 200% 0; } to { background-position: -200% 0; } }

/* media grid */
.media-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 2px; }
.gitem { aspect-ratio: 1/1; overflow: hidden; position: relative; background: #111; cursor: pointer; }
.gitem img, .gitem video { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
.gitem .playicon { position: absolute; top: 7px; right: 7px; color: #fff; font-size: 12px; text-shadow: 0 1px 4px rgba(0,0,0,0.7); }

/* shop + events */
.shop-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; padding: 14px; }
.product-card { border-radius: 16px; overflow: hidden; background: rgba(255,255,255,0.04); box-shadow: inset 0 0 0 1px var(--pg-line); }
.product-card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; background: #111; }
.product-card .pinfo { padding: 10px 12px 12px; }
.product-card .ptitle { font-size: 13.5px; font-weight: 600; line-height: 1.3; }
.product-card .pprice { font-size: 14px; font-weight: 800; color: var(--gold); margin-top: 4px; }
.events-list { padding: 14px; display: flex; flex-direction: column; gap: 12px; }
.event-card { display: flex; gap: 14px; padding: 14px; border-radius: 16px; background: rgba(255,255,255,0.04); box-shadow: inset 0 0 0 1px var(--pg-line); }
.event-date-box { flex-shrink: 0; width: 54px; height: 58px; border-radius: 12px; background: rgba(227,196,141,0.1); display: flex; flex-direction: column; align-items: center; justify-content: center; }
.event-date-box .mon { font-size: 10.5px; font-weight: 800; color: var(--gold); text-transform: uppercase; letter-spacing: .5px; }
.event-date-box .day { font-size: 20px; font-weight: 800; }
.event-info .etitle { font-size: 14.5px; font-weight: 700; }
.event-info .emeta { font-size: 12.5px; color: var(--text-sub); margin-top: 3px; }

/* reviews */
.pg-rv-sum { display: flex; align-items: center; gap: 22px; padding: 20px 18px 16px; }
.pg-rv-big { text-align: center; min-width: 78px; }
.pg-rv-big b { display: block; font-size: 40px; font-weight: 800; letter-spacing: -1px; line-height: 1; }
.pg-stars { color: #f5b942; letter-spacing: 1px; font-size: 13px; }
.pg-rv-big small { display: block; margin-top: 6px; color: var(--text-sub); font-size: 12px; }
.pg-rv-bars { flex: 1; display: flex; flex-direction: column; gap: 6px; }
.pg-rv-bar { display: flex; align-items: center; gap: 9px; font-size: 11.5px; color: var(--text-sub); }
.pg-rv-bar i { flex: 1; height: 6px; border-radius: 4px; background: rgba(255,255,255,0.07); overflow: hidden; display: block; }
.pg-rv-bar i s { display: block; height: 100%; border-radius: 4px; background: linear-gradient(135deg, #fde08d, #b8860b); }
.pg-rv-cta { padding: 0 16px 8px; }
.pg-rv-cta .pg-btn { width: 100%; }
.pg-rv { padding: 16px 18px; border-top: 1px solid var(--pg-line); }
.pg-rv-h { display: flex; align-items: center; gap: 11px; }
.pg-rv-av { width: 38px; height: 38px; border-radius: 50%; background: linear-gradient(135deg, #fde08d, #b8860b); color: #1a1204; font-weight: 800; display: flex; align-items: center; justify-content: center; font-size: 15px; text-transform: uppercase; flex-shrink: 0; }
.pg-rv-n { font-size: 14px; font-weight: 700; }
.pg-rv-d { font-size: 12px; color: var(--text-sub); }
.pg-rv-t { margin-top: 9px; font-size: 14.5px; line-height: 1.5; color: #d9dce2; overflow-wrap: anywhere; }

/* about */
.pg-ab { padding: 6px 0 20px; }
.pg-ab h3 { font-size: 12.5px; font-weight: 700; color: var(--gold); letter-spacing: .6px; text-transform: uppercase; padding: 20px 18px 8px; }
.pg-ab p { padding: 0 18px; font-size: 14.5px; line-height: 1.6; color: #d9dce2; white-space: pre-line; overflow-wrap: anywhere; }
.pg-ab-row { display: flex; align-items: center; gap: 14px; padding: 12px 18px; min-height: 48px; }
.pg-ab-row i { width: 18px; text-align: center; color: var(--text-sub); font-size: 15px; flex-shrink: 0; }
.pg-ab-row div { flex: 1; min-width: 0; }
.pg-ab-row b { display: block; font-size: 14.5px; font-weight: 500; overflow-wrap: anywhere; }
.pg-ab-row small { display: block; font-size: 12px; color: var(--text-sub); margin-top: 1px; }
.pg-ab-row a b { color: var(--gold); }

/* blocked */
.pg-blocked { padding: 60px 30px; text-align: center; color: var(--text-sub); font-size: 14px; line-height: 1.6; }
.pg-blocked .pg-btn { margin-top: 16px; }

/* ================= SHEETS / OVERLAYS ================= */
#pgSheetWrap { position: fixed; inset: 0; z-index: 30000; display: none; }
#pgSheetBg { position: absolute; inset: 0; background: rgba(0,0,0,0.62); }
#pgSheet { position: absolute; left: 0; right: 0; bottom: 0; max-height: 90%; overflow-y: auto; background: #121214; border-radius: 24px 24px 0 0; padding: 10px 0 calc(18px + env(safe-area-inset-bottom)); animation: pgUp .24s cubic-bezier(.2,.9,.3,1); box-shadow: 0 -12px 40px rgba(0,0,0,0.5); -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
@keyframes pgUp { from { transform: translateY(46px); opacity: .5; } to { transform: none; opacity: 1; } }
.pg-grab { width: 38px; height: 4px; border-radius: 2px; background: rgba(255,255,255,0.2); margin: 0 auto 14px; }
.pg-sh-head { display: flex; align-items: center; gap: 12px; padding: 2px 20px 14px; }
.pg-sh-head img { width: 44px; height: 44px; border-radius: 50%; object-fit: cover; background: #262626; }
.pg-sh-t { color: #fff; font-size: 18px; font-weight: 700; padding: 0 20px 6px; }
.pg-sh-head .pg-sh-t { padding: 0; font-size: 16px; }
.pg-sh-m { color: var(--text-sub); font-size: 13.5px; line-height: 1.5; padding: 0 20px 12px; }
.pg-sh-head .pg-sh-m { padding: 0; margin-top: 1px; font-size: 12.5px; }
.pg-row { display: flex; align-items: center; gap: 15px; padding: 13px 20px; cursor: pointer; min-height: 52px; }
.pg-row:active { background: rgba(255,255,255,0.05); }
.pg-row > i:first-child { width: 22px; text-align: center; font-size: 17px; color: #cfd3da; flex-shrink: 0; }
.pg-row .t { flex: 1; min-width: 0; font-size: 15.5px; font-weight: 500; color: #fff; }
.pg-row .t small { display: block; font-size: 12.5px; color: var(--text-sub); font-weight: 400; margin-top: 1px; }
.pg-row.danger .t, .pg-row.danger > i:first-child { color: #ff5c73; }
.pg-sep { height: 1px; background: var(--pg-line); margin: 6px 20px; }
.pg-dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.28); flex-shrink: 0; position: relative; }
.pg-dot.on { border-color: var(--gold); } .pg-dot.on::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--gold); }
.pg-field { padding: 4px 20px 12px; }
.pg-field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--text-sub); margin-bottom: 7px; }
.pg-field input, .pg-field textarea, .pg-field select { width: 100%; background: rgba(255,255,255,0.06); border: 1px solid transparent; border-radius: 12px; padding: 12px 14px; color: #fff; font-size: 16px; font-family: inherit; outline: none; }
.pg-field input:focus, .pg-field textarea:focus, .pg-field select:focus { border-color: rgba(227,196,141,0.55); }
.pg-field textarea { resize: none; line-height: 1.45; }
.pg-seg { display: flex; margin: 0 20px 14px; padding: 3px; background: rgba(255,255,255,0.06); border-radius: 12px; }
.pg-seg div { flex: 1; text-align: center; padding: 9px 4px; border-radius: 9px; font-size: 13.5px; font-weight: 600; color: var(--text-sub); cursor: pointer; }
.pg-seg div.on { background: rgba(255,255,255,0.13); color: #fff; }
.pg-sh-btns { display: flex; flex-direction: column; gap: 10px; padding: 8px 20px 0; }
.pg-sh-btns .pg-btn { height: 48px; border-radius: 14px; font-size: 15.5px; width: 100%; }
.pg-sh-btns .pg-btn.danger { background: #d63a52; }
.pg-stars-in { display: flex; justify-content: center; gap: 10px; padding: 6px 0 16px; }
.pg-stars-in i { font-size: 34px; color: rgba(255,255,255,0.18); cursor: pointer; }
.pg-stars-in i.on { color: #f5b942; }
.pg-ins { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 4px 20px 6px; }
.pg-ins div { padding: 14px; border-radius: 14px; background: rgba(255,255,255,0.05); }
.pg-ins b { display: block; font-size: 22px; font-weight: 800; }
.pg-ins small { display: block; color: var(--text-sub); font-size: 12px; margin-top: 3px; }
.pg-chart { display: flex; align-items: flex-end; gap: 6px; height: 84px; padding: 4px 20px 0; }
.pg-chart div { flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: flex-end; height: 100%; gap: 5px; }
.pg-chart i { width: 100%; border-radius: 5px 5px 0 0; background: linear-gradient(180deg, #fde08d, #b8860b); display: block; min-height: 4px; }
.pg-chart small { font-size: 10px; color: var(--text-sub); }
.pg-admin { display: flex; align-items: center; gap: 12px; padding: 10px 20px; }
.pg-admin span { flex: 1; font-size: 15px; } .pg-admin small { color: var(--text-sub); margin-left: 6px; font-size: 12.5px; }
.pg-chip-btn { border: 0; background: rgba(255,255,255,0.09); color: #fff; font-size: 12.5px; font-weight: 600; padding: 7px 13px; border-radius: 20px; cursor: pointer; }
.pg-chip-btn.danger { color: #ff5c73; }

.pg-ov { position: fixed; inset: 0; z-index: 30010; background: #050505; display: none; flex-direction: column; }
.pg-ov-top { flex-shrink: 0; height: calc(58px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 8px 0; display: flex; align-items: center; gap: 6px; border-bottom: 1px solid var(--pg-line); }
.pg-ov-top .bk { width: 42px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
.pg-ov-top input { flex: 1; height: 42px; background: transparent; border: 0; outline: 0; color: #fff; font-size: 17px; font-family: inherit; }
.pg-ov-body { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding-bottom: 30px; }
#pgLight { background: #000; z-index: 30020; }
#pgLight .strip { flex: 1; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
#pgLight .strip::-webkit-scrollbar { display: none; }
#pgLight .slide { flex: 0 0 100%; scroll-snap-align: center; display: flex; align-items: center; justify-content: center; position: relative; }
#pgLight .slide img, #pgLight .slide video { max-width: 100%; max-height: 100%; object-fit: contain; }
#pgLight .lt { position: absolute; top: 0; left: 0; right: 0; z-index: 3; height: calc(56px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 12px 0; display: flex; align-items: center; justify-content: space-between; background: linear-gradient(rgba(0,0,0,.6), transparent); color: #fff; }
#pgLight .lt span { font-size: 14px; font-weight: 600; } #pgLight .lt i { font-size: 20px; padding: 8px; cursor: pointer; }
#pgLight .cap { position: absolute; left: 0; right: 0; bottom: 0; padding: 40px 18px calc(18px + env(safe-area-inset-bottom)); background: linear-gradient(transparent, rgba(0,0,0,.7)); color: #fff; font-size: 14px; text-align: center; z-index: 3; }

#pgToast { position: fixed; left: 50%; bottom: calc(40px + env(safe-area-inset-bottom)); transform: translate(-50%, 20px); background: rgba(236,236,240,0.97); color: #111; font-size: 14px; font-weight: 600; padding: 11px 20px; border-radius: 24px; z-index: 60000; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; max-width: 88%; text-align: center; }
#pgToast.show { opacity: 1; transform: translate(-50%, 0); }
::-webkit-scrollbar { width: 0; height: 0; }
