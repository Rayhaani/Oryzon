/* ============================================================
   nx-core.css — ONE place for things every Nexus page shares
   (imported by pages.css, channels.css, chats.css)
   1. Typography: Google Play Store type scale (font + sizes)
   2. Top-right header icons (exact copy of chats.html .header-icons)
   3. Nexus avatar  .nx-av  (gold ring)
   Change a value here and pages, channels and chats all follow.
   ============================================================ */
@import url('https://fonts.googleapis.com/css2?family=Google+Sans:wght@400;500;700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Google+Sans+Flex:wght@400..700&display=swap');
@import url('https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&display=swap');

:root {
    /* Play Store: Google Sans. Roboto is only the safety net if the font cannot load. */
    --nx-font: 'Google Sans', 'Google Sans Flex', 'Google Sans Text', 'Product Sans', 'Roboto', sans-serif;
    /* Play Store type scale measured from the Play Store screenshot */
    --nx-fs-s: 12px;   /* sub-lines, ratings, nav labels, captions */
    --nx-fs-m: 14px;   /* item titles, chips, buttons, body */
    --nx-fs-l: 18px;   /* section headers */
    --nx-fw: 500;      /* Play Store titles/headers/buttons are Medium */
    --nx-fw-r: 400;    /* Play Store sub-lines are Regular */
}

/* ---------- top-right icons: exact copy of chats.css .header-icons ---------- */
.header-icons { display: flex; gap: 16px; align-items: center; flex-shrink: 0; color: #fff; }
.header-icons svg { width: 20px; height: 20px; cursor: pointer; flex-shrink: 0; }
.header-icons .nx-dots { display: flex; align-items: center; gap: 3px; cursor: pointer; padding: 0 2px; }

@keyframes dotSequence {
    0%, 100% { transform: scale(1); opacity: 0.3; }
    50% { transform: scale(1.4); opacity: 1; }
}

/* ---------- Nexus avatar (exact copy of .nx-av) ---------- */
:root { --nx-av: 48px; --nx-av-p: calc(var(--nx-av) * 0.0476); }
.nx-av { position: relative; display: block; width: var(--nx-av); height: var(--nx-av); padding: var(--nx-av-p); border-radius: 50%; background: linear-gradient(135deg, #fde08d, #b8860b); box-sizing: border-box; flex-shrink: 0; cursor: pointer; }
.nx-av > img, .nx-av > .nx-ini { display: block; width: 100% !important; height: 100% !important; box-sizing: content-box !important; border: var(--nx-av-p) solid #050505 !important; border-radius: 50% !important; background: #262626 !important; object-fit: cover; position: relative; z-index: 2; padding: 0 !important; }
.nx-av > .nx-ini { display: flex; align-items: center; justify-content: center; color: #fde08d; font-weight: 800; font-size: calc(var(--nx-av) * 0.34); line-height: 1; }
