/* ============================================================
   CHANNELS.CSS — Nexus Channels (SPA: loaded by router.js)
   Brand: black #050505 + the official post-header gold.
   ============================================================ */
:root {
  --bg: #050505;
  --surface: #111113;
  --surface-2: #18181b;
  --line: rgba(255, 255, 255, 0.07);
  --text: #f4f5f7;
  --sub: #9aa0ab;
  --gold: #E3C48D;
  --gold-deep: #B8860B;
  --danger: #ff5c73;
  --ok: #34d399;
  --hh: 58px;
}
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html, body { overflow-y: auto; }
body {
  background: #050505 !important; background-image: none !important; color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif;
  min-height: 100vh; overflow-x: hidden; -webkit-font-smoothing: antialiased;
}
button { font-family: inherit; color: inherit; background: none; border: 0; cursor: pointer; }
a { color: var(--gold); text-decoration: none; }
svg { display: block; }

/* ================= HEADER ================= */
header {
  position: sticky; top: 0; z-index: 50; height: var(--hh);
  display: flex; align-items: center; gap: 12px; padding: 0 14px;
  background: rgba(5, 5, 5, 0.78);
  backdrop-filter: blur(16px) saturate(1.2); -webkit-backdrop-filter: blur(16px) saturate(1.2);
  border-bottom: 1px solid var(--line);
}
.back-trigger { cursor: pointer; display: flex; align-items: center; justify-content: center; width: 34px; height: 40px; margin-left: -6px; flex-shrink: 0; }
.channel-avatar {
  width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; cursor: pointer; overflow: hidden;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #fde08d, #b8860b); color: #050505; font-weight: 800; font-size: 15px;
}
.channel-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }
.channel-meta { flex: 1; min-width: 0; cursor: pointer; }
.channel-meta h1 { font-size: 16px; font-weight: 700; display: flex; align-items: center; gap: 5px; line-height: 1.25; }
.channel-meta h1 .nm { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.channel-meta h1 svg { flex-shrink: 0; }
.channel-meta p { font-size: 12.5px; color: var(--sub); margin-top: 1px; display: flex; align-items: center; gap: 5px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.header-icon-btn, .menu-icon { width: 38px; height: 40px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; border-radius: 50%; }
.header-icon-btn:active, .menu-icon:active { background: rgba(255, 255, 255, 0.08); }

/* ================= PINNED BAR ================= */
.ch-pin { position: sticky; top: var(--hh); z-index: 40; display: flex; align-items: center; gap: 11px; padding: 9px 16px; background: rgba(14, 14, 16, 0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); cursor: pointer; }
.ch-pin[hidden] { display: none; }
.ch-pin::before { content: ''; width: 3px; align-self: stretch; border-radius: 2px; background: linear-gradient(180deg, #F8D9A2, #A77542); flex-shrink: 0; }
.ch-pin .pt { flex: 1; min-width: 0; }
.ch-pin b { display: block; font-size: 12px; font-weight: 700; color: var(--gold); letter-spacing: .2px; }
.ch-pin span { display: block; font-size: 13.5px; color: #d7d9de; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 1px; }

/* ================= FEED ================= */
.feed { max-width: 640px; margin: 0 auto; padding: 14px 12px 120px; }
.ch-sep { display: flex; justify-content: center; margin: 14px 0 12px; position: sticky; top: calc(var(--hh) + 8px); z-index: 5; pointer-events: none; }
.ch-sep span { background: rgba(28, 28, 31, 0.92); color: #b8bcc5; font-size: 12px; font-weight: 600; padding: 5px 13px; border-radius: 12px; border: 1px solid var(--line); }
.ch-msg { margin-bottom: 10px; }
.ch-msg.flash .ch-bubble { animation: chFlash 1.4s ease; }
@keyframes chFlash { 0%, 55% { box-shadow: 0 0 0 2px rgba(227, 196, 141, 0.7); } 100% { box-shadow: 0 0 0 2px rgba(227, 196, 141, 0); } }
.ch-bubble { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; overflow: hidden; max-width: 100%; }
.ch-bubble.sched { border-style: dashed; border-color: rgba(227, 196, 141, 0.4); }
.ch-tag { display: flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; color: var(--gold); padding: 11px 14px 0; }
.ch-tag.ok { color: var(--ok); }
.ch-media { position: relative; background: #0b0b0c; }
.ch-media img, .ch-media video { width: 100%; max-height: 520px; display: block; object-fit: cover; background: #0b0b0c; }
.ch-media img { aspect-ratio: 4 / 3; cursor: zoom-in; }
.ch-media img.loaded { aspect-ratio: auto; }
.ch-body { padding: 11px 14px 4px; }
.ch-bubble > .ch-media + .ch-body { padding-top: 10px; }
.ch-text { font-size: 15px; line-height: 1.5; color: #ececef; white-space: pre-wrap; word-wrap: break-word; overflow-wrap: anywhere; }
.ch-text:empty { display: none; }
.ch-text a { text-decoration: underline; text-underline-offset: 2px; }
.ch-react { display: flex; flex-wrap: wrap; gap: 6px; padding: 8px 14px 0; }
.ch-pill { display: inline-flex; align-items: center; gap: 5px; height: 29px; padding: 0 10px; border-radius: 15px; background: rgba(255, 255, 255, 0.06); border: 1px solid transparent; font-size: 13px; font-weight: 600; color: #d4d6db; }
.ch-pill:active { transform: scale(.95); }
.ch-pill.on { border-color: rgba(227, 196, 141, 0.7); background: rgba(227, 196, 141, 0.12); color: var(--gold); }
.ch-pill.zero { display: none; }
.ch-react.open .ch-pill.zero { display: inline-flex; }
.ch-pill.add { width: 29px; padding: 0; justify-content: center; color: var(--sub); }
.ch-meta { display: flex; align-items: center; justify-content: flex-end; gap: 10px; padding: 7px 8px 9px 14px; font-size: 11.5px; color: #7f8591; }
.ch-meta .sp { flex: 1; }
.ch-meta .vw { display: inline-flex; align-items: center; gap: 4px; }
.ch-meta svg { opacity: .9; }
.ch-more { width: 28px; height: 24px; display: flex; align-items: center; justify-content: center; border-radius: 8px; color: #8b919c; }
.ch-more:active { background: rgba(255, 255, 255, 0.08); }

/* blocks inside a bubble */
.ch-block { margin: 2px 14px 10px; }
.ch-poll-q { font-size: 15px; font-weight: 700; line-height: 1.4; margin-bottom: 10px; }
.ch-opt { position: relative; border-radius: 11px; background: rgba(255, 255, 255, 0.05); overflow: hidden; margin-bottom: 7px; cursor: pointer; min-height: 40px; display: flex; align-items: center; border: 1px solid transparent; }
.ch-opt .fill { position: absolute; inset: 0 auto 0 0; background: rgba(227, 196, 141, 0.18); transition: width .45s ease; }
.ch-opt .row { position: relative; display: flex; justify-content: space-between; align-items: center; gap: 10px; width: 100%; padding: 10px 13px; font-size: 14px; }
.ch-opt.mine { border-color: rgba(227, 196, 141, 0.7); }
.ch-opt.mine .row b::after { content: ' ✓'; color: var(--gold); }
.ch-opt .row span:last-child { font-weight: 700; font-size: 13px; color: #cfd2d8; }
.ch-poll-meta { font-size: 12px; color: var(--sub); margin-top: 2px; }
.ch-card { border: 1px solid var(--line); background: rgba(255, 255, 255, 0.03); border-radius: 14px; padding: 13px; }
.ch-card h4 { font-size: 13px; font-weight: 700; color: var(--gold); display: flex; align-items: center; gap: 7px; margin-bottom: 10px; }
.ch-track { height: 7px; border-radius: 4px; background: rgba(255, 255, 255, 0.09); overflow: hidden; margin-bottom: 9px; }
.ch-track i { display: block; height: 100%; border-radius: 4px; background: linear-gradient(90deg, #E3C48D, #B8860B); transition: width .45s ease; }
.ch-info { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--sub); margin-bottom: 11px; }
.ch-info s { opacity: .55; margin-right: 6px; }
.ch-info b { color: #fff; font-weight: 700; }
.ch-reveal { font-size: 14px; line-height: 1.5; color: #ececef; white-space: pre-wrap; overflow-wrap: anywhere; }

/* ================= BUTTONS ================= */
.ch-btn { height: 40px; padding: 0 18px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; gap: 8px; font-size: 14px; font-weight: 700; color: #fff; white-space: nowrap; position: relative; isolation: isolate; transition: transform .12s, opacity .12s; }
.ch-btn:active { transform: scale(.97); }
.ch-btn.pri { background: transparent; }
.ch-btn.pri::before { content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: -1; background:
  linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.18) 55%, rgba(0,0,0,0) 78%),
  url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.15'/></svg>"),
  radial-gradient(ellipse 90% 140% at 48% 0%, #F8D9A2 0%, #E3C48D 22%, #C09060 50%, #A77542 72%, #8B5B2D 100%);
  background-blend-mode: overlay, normal; filter: brightness(0.7); }
.ch-btn.sec { background: rgba(255, 255, 255, 0.09); box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.1); }
.ch-btn.danger { background: #d63a52; }
.ch-btn.block { width: 100%; }
.ch-btn.dis, .ch-btn:disabled { opacity: .5; pointer-events: none; }
.ch-btn.sm { height: 32px; padding: 0 13px; font-size: 12.5px; border-radius: 10px; }

/* ================= BOTTOM BAR ================= */
.ch-bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; background: rgba(5, 5, 5, 0.94); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-top: 1px solid var(--line); padding: 10px 12px calc(10px + env(safe-area-inset-bottom)); }
.ch-bar-in { max-width: 640px; margin: 0 auto; }
.ch-bar .ch-btn.block { height: 46px; font-size: 15px; border-radius: 14px; }
.ch-mute { width: 100%; height: 46px; display: flex; align-items: center; justify-content: center; gap: 9px; font-size: 15px; font-weight: 700; color: var(--gold); border-radius: 14px; }
.ch-mute:active { background: rgba(255, 255, 255, 0.05); }
.ch-comp { display: flex; align-items: flex-end; gap: 8px; }
.ch-comp .ib { width: 42px; height: 42px; border-radius: 50%; background: rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ch-comp .ib:active { background: rgba(255, 255, 255, 0.14); }
.ch-comp textarea { flex: 1; min-width: 0; resize: none; background: rgba(255, 255, 255, 0.07); border: 1px solid transparent; border-radius: 22px; padding: 11px 16px; color: #fff; font-size: 16px; line-height: 1.35; font-family: inherit; outline: none; max-height: 130px; height: 42px; }
.ch-comp textarea:focus { border-color: rgba(227, 196, 141, 0.45); }
.ch-comp textarea::placeholder { color: rgba(255, 255, 255, 0.4); }
.ch-send { width: 42px; height: 42px; border-radius: 50%; flex-shrink: 0; display: flex; align-items: center; justify-content: center; position: relative; isolation: isolate; }
.ch-send::before { content: ''; position: absolute; inset: 0; border-radius: 50%; z-index: -1; background: radial-gradient(ellipse 90% 140% at 48% 0%, #F8D9A2 0%, #E3C48D 22%, #C09060 50%, #A77542 72%, #8B5B2D 100%); filter: brightness(0.75); }
.ch-send.dis { opacity: .4; pointer-events: none; }
.ch-chips { display: flex; gap: 8px; flex-wrap: wrap; padding-bottom: 9px; }
.ch-chips:empty { display: none; }
.ch-chip { display: flex; align-items: center; gap: 9px; background: rgba(255, 255, 255, 0.07); border-radius: 12px; padding: 5px 6px 5px 5px; font-size: 12.5px; color: #d9dbe0; max-width: 100%; }
.ch-chip .th { width: 38px; height: 38px; border-radius: 8px; background: #1b1b1e center/cover; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
.ch-chip .tx { min-width: 0; padding-right: 2px; } .ch-chip .tx small { display: block; color: var(--sub); font-size: 11.5px; }
.ch-chip .x { width: 26px; height: 26px; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #9aa0ab; flex-shrink: 0; }
.ch-chip .x:active { background: rgba(255, 255, 255, 0.1); }
.ch-chip.sch { background: rgba(227, 196, 141, 0.1); color: var(--gold); padding-left: 11px; }
.ch-prog { height: 3px; border-radius: 2px; background: rgba(255, 255, 255, 0.1); overflow: hidden; margin-top: 3px; }
.ch-prog i { display: block; height: 100%; width: 0; background: var(--gold); transition: width .2s; }

#toLatest { position: fixed; right: 14px; bottom: 90px; z-index: 45; width: 44px; height: 44px; border-radius: 50%; background: #1d1d20; border: 1px solid rgba(255, 255, 255, 0.12); display: none; align-items: center; justify-content: center; box-shadow: 0 6px 20px rgba(0, 0, 0, 0.5); }
#toLatest.show { display: flex; }
#toLatest em { position: absolute; top: -7px; right: -3px; min-width: 20px; height: 20px; padding: 0 5px; border-radius: 10px; background: var(--gold); color: #050505; font-size: 11.5px; font-style: normal; font-weight: 800; display: none; align-items: center; justify-content: center; }
#toLatest em.on { display: flex; }

/* ================= EMPTY / SKELETON ================= */
.ch-empty { text-align: center; padding: 70px 30px; color: var(--sub); }
.ch-empty .ic { width: 66px; height: 66px; border-radius: 50%; background: rgba(255, 255, 255, 0.05); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; color: #8b919c; }
.ch-empty h3 { color: #fff; font-size: 17px; font-weight: 700; margin-bottom: 6px; }
.ch-empty p { font-size: 14px; line-height: 1.5; }
.ch-empty .ch-btn { margin-top: 18px; }
.ch-sk { border-radius: 18px; height: 120px; margin-bottom: 10px; background: linear-gradient(100deg, #111113 30%, #1a1a1d 50%, #111113 70%); background-size: 200% 100%; animation: chSk 1.3s linear infinite; }
.ch-sk.t { height: 190px; }
@keyframes chSk { to { background-position: -200% 0; } }

/* ================= SHEETS ================= */
#chSheetWrap { position: fixed; inset: 0; z-index: 30000; display: none; }
#chSheetBg { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.62); }
#chSheet { position: absolute; left: 0; right: 0; bottom: 0; max-width: 640px; margin: 0 auto; max-height: 90%; overflow-y: auto; background: #121214; border-radius: 24px 24px 0 0; padding: 10px 0 calc(18px + env(safe-area-inset-bottom)); animation: chUp .24s cubic-bezier(.2, .9, .3, 1); box-shadow: 0 -12px 40px rgba(0, 0, 0, 0.5); -webkit-overflow-scrolling: touch; overscroll-behavior: contain; }
@keyframes chUp { from { transform: translateY(40px); opacity: 0; } to { transform: none; opacity: 1; } }
.ch-grab { width: 38px; height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.2); margin: 0 auto 14px; }
.ch-sh-t { font-size: 18px; font-weight: 700; padding: 0 20px 6px; }
.ch-sh-m { color: var(--sub); font-size: 13.5px; line-height: 1.5; padding: 0 20px 12px; }
.ch-prof { text-align: center; padding: 4px 24px 10px; }
.ch-prof .av { width: 84px; height: 84px; border-radius: 50%; margin: 0 auto 12px; overflow: hidden; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #fde08d, #b8860b); color: #050505; font-weight: 800; font-size: 28px; }
.ch-prof .av img { width: 100%; height: 100%; object-fit: cover; }
.ch-prof h2 { font-size: 21px; font-weight: 800; display: flex; align-items: center; justify-content: center; gap: 6px; }
.ch-prof .sub { color: var(--sub); font-size: 13.5px; margin-top: 4px; }
.ch-prof .desc { color: #d5d8de; font-size: 14.5px; line-height: 1.55; margin-top: 14px; white-space: pre-wrap; overflow-wrap: anywhere; text-align: left; }
.ch-prof .acts { display: flex; gap: 10px; margin-top: 18px; }
.ch-prof .acts .ch-btn { flex: 1; }
.ch-row { display: flex; align-items: center; gap: 15px; padding: 13px 20px; cursor: pointer; min-height: 52px; }
.ch-row:active { background: rgba(255, 255, 255, 0.05); }
.ch-row > svg:first-child { width: 22px; flex-shrink: 0; color: #cfd3da; }
.ch-row .t { flex: 1; min-width: 0; font-size: 15.5px; font-weight: 500; }
.ch-row .t small { display: block; font-size: 12.5px; color: var(--sub); font-weight: 400; margin-top: 1px; overflow: hidden; text-overflow: ellipsis; }
.ch-row.danger .t, .ch-row.danger > svg:first-child { color: var(--danger); }
.ch-sep-l { height: 1px; background: var(--line); margin: 6px 20px; }
.ch-dot { width: 22px; height: 22px; border-radius: 50%; border: 2px solid rgba(255, 255, 255, 0.28); flex-shrink: 0; position: relative; }
.ch-dot.on { border-color: var(--gold); } .ch-dot.on::after { content: ''; position: absolute; inset: 3px; border-radius: 50%; background: var(--gold); }
.ch-sw { width: 44px; height: 26px; border-radius: 13px; background: rgba(255, 255, 255, 0.16); position: relative; flex-shrink: 0; transition: background .2s; }
.ch-sw::after { content: ''; position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: #fff; transition: transform .2s; }
.ch-sw.on { background: #A77542; } .ch-sw.on::after { transform: translateX(18px); }
.ch-field { padding: 4px 20px 12px; }
.ch-field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--sub); margin-bottom: 7px; }
.ch-field input, .ch-field textarea, .ch-field select { width: 100%; background: rgba(255, 255, 255, 0.06); border: 1px solid transparent; border-radius: 12px; padding: 12px 14px; color: #fff; font-size: 16px; font-family: inherit; outline: none; }
.ch-field input:focus, .ch-field textarea:focus, .ch-field select:focus { border-color: rgba(227, 196, 141, 0.55); }
.ch-field textarea { resize: none; line-height: 1.45; }
.ch-field select option { background: #18181b; }
.ch-two { display: flex; gap: 10px; padding: 0 20px; } .ch-two .ch-field { padding-left: 0; padding-right: 0; flex: 1; min-width: 0; }
.ch-seg { display: flex; margin: 0 20px 14px; padding: 3px; background: rgba(255, 255, 255, 0.06); border-radius: 12px; }
.ch-seg div { flex: 1; text-align: center; padding: 9px 4px; border-radius: 9px; font-size: 13.5px; font-weight: 600; color: var(--sub); cursor: pointer; }
.ch-seg div.on { background: rgba(255, 255, 255, 0.13); color: #fff; }
.ch-sh-btns { display: flex; flex-direction: column; gap: 10px; padding: 8px 20px 0; }
.ch-sh-btns .ch-btn { height: 48px; border-radius: 14px; font-size: 15.5px; width: 100%; }
.ch-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 4px; padding: 2px 14px 6px; }
.ch-grid .g { display: flex; flex-direction: column; align-items: center; gap: 9px; padding: 14px 4px; border-radius: 14px; font-size: 12.5px; font-weight: 600; color: #d7d9de; cursor: pointer; text-align: center; }
.ch-grid .g:active { background: rgba(255, 255, 255, 0.06); }
.ch-grid .g i { width: 50px; height: 50px; border-radius: 50%; background: rgba(255, 255, 255, 0.07); display: flex; align-items: center; justify-content: center; color: var(--gold); }
.ch-adm { display: flex; align-items: center; gap: 13px; padding: 11px 20px; }
.ch-adm > span { flex: 1; min-width: 0; font-size: 15px; font-weight: 600; overflow: hidden; text-overflow: ellipsis; } .ch-adm small { display: block; color: var(--sub); font-weight: 400; font-size: 12.5px; }
.ch-chipbtn { height: 30px; padding: 0 12px; border-radius: 9px; background: rgba(255, 255, 255, 0.09); font-size: 12.5px; font-weight: 700; }
.ch-chipbtn.danger { color: var(--danger); }
.ch-ins { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; padding: 0 20px; }
.ch-ins > div { background: rgba(255, 255, 255, 0.05); border-radius: 14px; padding: 14px; }
.ch-ins b { display: block; font-size: 23px; font-weight: 800; } .ch-ins small { color: var(--sub); font-size: 12.5px; }
.ch-top { padding: 0 20px; } .ch-top .it { display: flex; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--line); font-size: 14px; } .ch-top .it:last-child { border: 0; }
.ch-top .it span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; } .ch-top .it b { color: var(--gold); font-size: 13px; }
.ch-editav { display: flex; align-items: center; gap: 14px; padding: 0 20px 14px; }
.ch-editav .av { width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: linear-gradient(135deg, #fde08d, #b8860b); display: flex; align-items: center; justify-content: center; color: #050505; font-weight: 800; font-size: 22px; flex-shrink: 0; }
.ch-editav .av img { width: 100%; height: 100%; object-fit: cover; }

/* ================= OVERLAYS ================= */
.ch-ov { position: fixed; inset: 0; z-index: 30010; background: #050505; display: none; flex-direction: column; }
.ch-ov-top { flex-shrink: 0; height: calc(58px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 8px 0; display: flex; align-items: center; gap: 6px; border-bottom: 1px solid var(--line); }
.ch-ov-top .bk { width: 42px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
.ch-ov-top input { flex: 1; height: 42px; background: transparent; border: 0; outline: 0; color: #fff; font-size: 17px; font-family: inherit; }
.ch-ov-body { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding-bottom: 30px; }
.ch-hit { display: block; padding: 13px 18px; border-bottom: 1px solid var(--line); cursor: pointer; }
.ch-hit:active { background: rgba(255, 255, 255, 0.05); }
.ch-hit small { color: var(--sub); font-size: 12px; } .ch-hit div { font-size: 14.5px; color: #e4e6ea; margin-top: 3px; line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.ch-hit mark { background: rgba(227, 196, 141, 0.28); color: #fff; border-radius: 3px; }
#chLight { background: rgba(0, 0, 0, 0.97); align-items: center; justify-content: center; }
#chLight img { max-width: 100%; max-height: 100%; object-fit: contain; }
#chLight .x { position: absolute; top: calc(12px + env(safe-area-inset-top)); left: 12px; width: 42px; height: 42px; border-radius: 50%; background: rgba(255, 255, 255, 0.12); display: flex; align-items: center; justify-content: center; }

/* ================= TOAST ================= */
#chToast { position: fixed; left: 50%; bottom: calc(90px + env(safe-area-inset-bottom)); transform: translate(-50%, 20px); background: rgba(236, 236, 240, 0.97); color: #111; font-size: 14px; font-weight: 600; padding: 11px 20px; border-radius: 24px; z-index: 60000; opacity: 0; pointer-events: none; transition: opacity .2s, transform .2s; max-width: 88%; text-align: center; }
#chToast.show { opacity: 1; transform: translate(-50%, 0); }
