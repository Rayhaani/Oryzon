@import url('chat-shared.css');
/* chat-interior.css — ONLY what is specific to the 1:1 chat page.
   The chat surface (bubbles, media, ticks, reply quotes, reactions, day divider,
   typing bar, attach sheet) lives in chat-shared.css, shared with group.html. */
:root { --obsidian: #050505; --presence-live: #34C759; }
body { font-family: 'Inter', sans-serif; }
/* wrapper row kept so selection / swipe-to-reply work; the visible bubble is the shared .msg-row */
.message-row { display: flex; margin: 0 -10px; padding: 0 10px; transition: background 0.15s; }
.message-row.row-incoming { justify-content: flex-start; }
.message-row.row-outgoing { justify-content: flex-end; }
.message-row.msg-grouped { margin-top: -3px; }
.message-row.selected-highlight { background: rgba(253, 224, 141, 0.16); }
#chat-flow > .message-row, #chat-flow > .day-divider { flex-shrink: 0; }
#voiceBtn { display: none; }
.input-area.caption-active { z-index: 100000; }
#normalInputRow { width: 100%; }
.media-sending .pending-pct { font-size: 11px; color: rgba(255,255,255,0.9); margin-left: 8px; }

.pending-audio-track { flex:1; height:3px; background:rgba(255,255,255,0.2); border-radius:2px; overflow:hidden; }
.pending-audio-fill { height:100%; background:#eab308; width:0%; transition: width 0.2s; }
        
body { background: #050505 !important; background-image: none !important; color: #fff; margin: 0; overflow: hidden; }
    /* ===== MEDIA BUBBLES ===== */

.pending-audio-row { display:flex; align-items:center; gap:10px; min-width:150px; padding:4px 2px; }

/* ===== FULLSCREEN MEDIA VIEWER (in-app, no external navigation) ===== */
#mediaViewerOverlay {
    display: none; position: fixed; inset: 0; background: #000; z-index: 99999;
    align-items: center; justify-content: center;
}
#mediaViewerOverlay.show { display: flex; }
#captionOverlay {
    display: none; position: fixed; inset: 0; background: #000; z-index: 99999;
    align-items: center; justify-content: center;
    touch-action: none; overscroll-behavior: none;
}
#captionOverlay.show { display: flex; }
.input-area.caption-active { z-index: 100000; }
#captionPreviewArea { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
#captionPreviewArea img, #captionPreviewArea video { max-width: 100%; max-height: 100%; object-fit: contain; }

.starred-badge, .pinned-badge { font-size: 10px; margin-left: 4px; opacity: 0.8; }
.cap-icon-btn {
    color: #fff; font-size: 14px; width: 33px; height: 33px; border-radius: 50%;
    background: rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-weight: 700; font-family: 'Inter', sans-serif; flex-shrink: 0;
}
.cap-icon-btn.active { background: var(--cyan-neon); color: #000; }
#captionPreviewArea canvas, #captionPreviewArea video { max-width: 100%; max-height: 100%; touch-action: none; }
#cropBox {
    position: absolute; border: 1px solid #fff; box-shadow: 0 0 0 9999px rgba(0,0,0,0.75);
    touch-action: none; z-index: 7;
}
.crop-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image: linear-gradient(rgba(255,255,255,0.45) 1px, transparent 1px),
                       linear-gradient(90deg, rgba(255,255,255,0.45) 1px, transparent 1px);
    background-size: 33.34% 33.34%;
}
.crop-handle { position: absolute; width: 26px; height: 26px; touch-action: none; }
.crop-handle::after { content: ''; position: absolute; width: 22px; height: 22px; top: 2px; left: 2px; background: #fff; border-radius: 50%; }
.ch-tl { top: -13px; left: -13px; cursor: nwse-resize; }
.ch-tr { top: -13px; right: -13px; cursor: nesw-resize; }
.ch-bl { bottom: -13px; left: -13px; cursor: nesw-resize; }
.ch-br { bottom: -13px; right: -13px; cursor: nwse-resize; }
.crop-edge { position: absolute; touch-action: none; }
.ce-top { top: -14px; left: 24px; right: 24px; height: 28px; cursor: ns-resize; }
.ce-bottom { bottom: -14px; left: 24px; right: 24px; height: 28px; cursor: ns-resize; }
.ce-left { left: -14px; top: 24px; bottom: 24px; width: 28px; cursor: ew-resize; }
.ce-right { right: -14px; top: 24px; bottom: 24px; width: 28px; cursor: ew-resize; }
#cropBottomBar {
    position: fixed; bottom: 0; left: 0; right: 0; z-index: 100002;
    display: flex; align-items: center; justify-content: space-between;
    padding: 16px 26px calc(16px + env(safe-area-inset-bottom)); background: rgba(0,0,0,0.55);
}
.crop-text-btn { color: var(--cyan-neon); font-size: 16px; font-weight: 700; cursor: pointer; padding: 6px 4px; }
#discardDialogBackdrop {
    display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.5); z-index: 100020;
    align-items: center; justify-content: center;
}
#discardDialogBackdrop.show { display: flex; }
#discardDialog { background: #1c1c1e; border-radius: 14px; width: 84%; max-width: 340px; padding: 20px 20px 14px; }
#discardDialog p { color: #fff; font-size: 16px; margin-bottom: 18px; }
#discardDialog .discard-dialog-actions { display: flex; justify-content: flex-end; gap: 24px; }
#discardDialog .discard-dialog-actions span { color: var(--cyan-neon); font-size: 15px; font-weight: 700; cursor: pointer; }
#textToolOverlay { position: fixed; inset: 0; z-index: 100003; display: flex; flex-direction: column; }
#textToolTop { position: relative; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 14px 18px; }
#textToolDim { position: absolute; inset: 0; background: rgba(0,0,0,0.45); z-index: 0; }
#textToolInputWrap {
    position: absolute; z-index: 1; transform: translate(-50%, -50%);
    max-width: 82vw; touch-action: none;
}
#textToolInput {
    outline: none; font-size: 26px; font-weight: 700; text-align: center; min-width: 24px;
    padding: 8px 12px; font-family: 'Inter', sans-serif; white-space: pre-wrap; word-break: break-word;
    line-height: 1.3; cursor: move;
}
#textToolInput:empty::before { content: attr(data-placeholder); color: rgba(255,255,255,0.55); }
#textStyleRow {
    position: relative; z-index: 2; display: flex; gap: 10px; overflow-x: auto;
    padding: 10px 16px calc(14px + env(safe-area-inset-bottom)); justify-content: center;
    touch-action: pan-x;
}
.text-style-swatch {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center;
    justify-content: center; font-weight: 800; font-size: 14px; cursor: pointer;
}
.text-style-swatch.active { box-shadow: 0 0 0 2px var(--cyan-neon); }

#drawToolBar {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100002; padding: 14px 16px;
    display: flex; flex-direction: column; gap: 14px; background: linear-gradient(180deg, rgba(0,0,0,0.65), transparent);
    touch-action: none;
}
#drawToolTopRow { display: flex; justify-content: flex-end; }
#drawBrushRow { display: flex; gap: 14px; align-items: center; }
.brush-opt {
    width: 34px; height: 34px; border-radius: 50%; background: rgba(255,255,255,0.14);
    display: flex; align-items: center; justify-content: center; cursor: pointer;
}
.brush-opt.active { background: var(--cyan-neon); }
.brush-opt.active i { color: #000 !important; }
#colorSliderWrap { position: fixed; right: 14px; top: 130px; bottom: 150px; width: 30px; z-index: 100010; touch-action: none; }
#colorSlider {
    width: 10px; height: 100%; margin: 0 auto; border-radius: 6px;
    background: linear-gradient(180deg, #ffffff 0%, #ff0000 8%, #ff9900 22%, #ffee00 36%, #33ff33 50%, #00e5ff 62%, #3366ff 75%, #a020f0 88%, #ff2fb0 100%);
}
#colorSliderDot {
    position: absolute; left: 50%; width: 22px; height: 22px; border-radius: 50%; border: 2px solid #fff;
    transform: translate(-50%, -50%); pointer-events: none; box-shadow: 0 0 4px rgba(0,0,0,0.6);
}
.mv-close {
    position: absolute; top: 16px; right: 16px; z-index: 3;
    color: #fff; font-size: 20px; width: 38px; height: 38px; border-radius: 50%;
    background: rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center;
    cursor: pointer;
}
#mediaViewerContent { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; position: relative; }
#mediaViewerContent img, #mediaViewerContent video { max-width: 100%; max-height: 100%; object-fit: contain; }
.mv-video-controls {
    position: absolute; left: 16px; right: 16px; bottom: 26px;
    display: flex; align-items: center; gap: 10px; z-index: 2;
}
.mv-time { color: #fff; font-size: 11px; font-family: 'Orbitron', sans-serif; min-width: 32px; text-align: center; }
.mv-track { flex: 1; height: 20px; display: flex; align-items: center; position: relative; cursor: pointer; touch-action: none; }
.mv-track-line { width: 100%; height: 3px; border-radius: 2px; background: rgba(255,255,255,0.28); position: relative; }
.mv-track-fill { position: absolute; left: 0; top: 0; height: 100%; width: 0%; background: #fff; border-radius: 2px; }
.mv-track-dot { position: absolute; top: 50%; left: 0%; width: 11px; height: 11px; border-radius: 50%; background: #fff; transform: translate(-50%,-50%); }
.mv-speed { color: #fff; font-size: 11px; border: 1px solid rgba(255,255,255,0.45); border-radius: 10px; padding: 3px 8px; cursor: pointer; font-weight: 600; flex-shrink: 0; }

/* ===== IMAGE GRID (WhatsApp-style) ===== */
/* Girman box din nan (255x340) DOLE ya zama IRI DAYA da .media-wrap (hoto
   guda daya), domin container din bai canzawa ko da hoto 1, 4, ko 10 ne. */

/* ===== CONTACT INFO OVERLAY (item 11) ===== */
.ci-row {
    display: flex; align-items: center; gap: 18px;
    padding: 15px 20px; cursor: pointer;
    transition: background 0.15s;
}
.ci-row:active { background: rgba(255,255,255,0.05); }
.ci-danger { color: #ff5c5c; }
.ci-danger i { color: #ff5c5c; }

/* Media visibility toggle (contact-info overlay) */
.hide-media img, .hide-media video, .hide-media .img-grid { filter: blur(22px); }

/* Date divider between days (item 7) */

/* End-to-end encryption notice at top of chat (item 12) */
.e2e-notice {
    align-self: center;
    max-width: 88%;
    background: rgba(255, 214, 10, 0.08);
    border: 1px solid rgba(255, 214, 10, 0.18);
    color: rgba(255, 224, 130, 0.85);
    font-size: 11px;
    line-height: 1.4;
    text-align: center;
    padding: 8px 14px;
    border-radius: 10px;
    margin-bottom: 6px;
}
.e2e-notice i { margin-right: 4px; }

/* Media gallery, grouped by sender (item 12) */
.gallery-section-label { color: rgba(255,255,255,0.5); font-size: 12px; font-weight: 700; padding: 14px 14px 8px; }
.gallery-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; padding: 0 2px; }
.gallery-tile { aspect-ratio: 1 / 1; background: #111; position: relative; overflow: hidden; cursor: pointer; }
.gallery-play-badge { position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); color: #fff; font-size: 18px; text-shadow: 0 1px 4px rgba(0,0,0,0.6); }

/* ===== CONTACT INFO (WhatsApp-style) ===== */
body.ci-info-open #chat-header-bar, body.ci-info-open .input-area:not(.in-viewer), body.ci-info-open #scrollToBottomBtn { display: none !important; }
#chatInfoOverlay, #chatInfoOverlay * { -webkit-touch-callout: none; }
#chatInfoOverlay .ci-hero, #chatInfoOverlay .ci-actions { -webkit-user-select: none; user-select: none; }
.ci-topbar { position: absolute; top: 0; left: 0; right: 0; height: 56px; display: flex; align-items: center; padding: 0 14px; z-index: 2; pointer-events: none; }
.ci-back { width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; cursor: pointer; pointer-events: auto; margin-left: -6px; }
.ci-hero { display: flex; flex-direction: column; align-items: center; padding: 40px 20px 14px; }
/* same gold-ring avatar as the chat header (.avatar-frame + .group-avatar), scaled: ring and gap grow with the size */
.ci-hero-frame { width: 168px; height: 168px; padding: 8px; cursor: pointer; }   /* 168 x 2/42 = the header avatar's ratio */
.ci-hero-avatar { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; background: #262626; border: 8px solid #050505; cursor: pointer; display: block; box-sizing: content-box; }
.ci-hero-name { color: #fff; font-size: 26px; font-weight: 600; margin-top: 16px; text-align: center; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ci-hero-status { color: rgba(255,255,255,0.6); font-size: 15px; margin-top: 3px; text-align: center; }
.ci-actions { display: flex; justify-content: center; gap: 12px; padding: 14px 16px 26px; }
.ci-act { display: flex; flex-direction: column; align-items: center; gap: 7px; cursor: pointer; width: 84px; }
.ci-act-btn { width: 84px; height: 54px; border-radius: 18px; background: #1c1c1e; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 19px; transition: background .15s; }
.ci-act:active .ci-act-btn { background: #2a2a2d; }
.ci-act span { color: #fff; font-size: 13px; font-weight: 500; }
.ci-media { padding: 6px 0 14px; }
.ci-media-head { display: flex; align-items: center; gap: 8px; padding: 14px 16px 10px; cursor: pointer; }
.ci-media-title { flex: 1; color: #fff; font-size: 15px; font-weight: 500; }
.ci-media-count { color: rgba(255,255,255,0.6); font-size: 14px; }
.ci-media-head i { color: rgba(255,255,255,0.5); font-size: 12px; }
/* 3 full thumbnails + about 60% of the 4th, then it scrolls sideways */
.ci-media-strip { --t: min(calc((100vw - 28px) / 3.6), 130px); display: flex; gap: 4px; overflow-x: auto; padding: 0 0 0 16px; scrollbar-width: none; -webkit-overflow-scrolling: touch; scroll-snap-type: x proximity; scroll-padding-left: 16px; }
.ci-media-strip::-webkit-scrollbar { display: none; }
.ci-thumb { width: var(--t); height: var(--t); flex-shrink: 0; border-radius: 8px; overflow: hidden; background: #111; position: relative; cursor: pointer; scroll-snap-align: start; }
.ci-thumb img, .ci-thumb video { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; }
.ci-thumb .ci-play { position: absolute; left: 6px; bottom: 5px; color: #fff; font-size: 12px; text-shadow: 0 0 4px rgba(0,0,0,0.8); }
.ci-media-empty { color: rgba(255,255,255,0.4); font-size: 13px; padding: 4px 0; }
.ci-row span { font-size: 16px !important; }
.ci-row i { font-size: 17px; }
@media print { #chatInfoOverlay { display: none !important; } }
#nxShotBlock { position: fixed; inset: 0; z-index: 100200; background: #000; color: #fff; display: none; align-items: center; justify-content: center; text-align: center; padding: 30px; font-size: 16px; font-weight: 600; }
#nxShotBlock.show { display: flex; }

/* ===== header avatar: dark fill inside, gold only as the ring ===== */
#chat-header-bar .group-avatar { background: #262626; }

/* sender bubble = the EXACT .post-header background (copied 1:1 from post-card-template.js):
   same 3 layers, same blend mode, same brightness(0.7) — brightness is applied to a ::before layer so the text stays white. */
.message-row .msg-row.outgoing .msg-card:not([style*="transparent"]) { background: transparent !important; isolation: isolate; }
.message-row .msg-row.outgoing .msg-card:not([style*="transparent"])::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; z-index: -1; pointer-events: none;
    background:
linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.18) 55%, rgba(0,0,0,0) 78%),
    url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='100' height='100'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)' opacity='0.15'/></svg>"),
    radial-gradient(ellipse 90% 140% at 48% 0%, #F8D9A2 0%, #E3C48D 22%, #C09060 50%, #A77542 72%, #8B5B2D 100%);
    background-blend-mode: overlay, normal;
    filter: brightness(0.7);
}

/* ===== smooth scrolling ===== */
#chat-flow { overflow-anchor: auto; scroll-behavior: auto; }
.message-row { contain: layout style; }

#chatInfoOverlay .ci-row > i:first-child { width: 26px !important; text-align: center; font-size: 19px; }
#chatInfoOverlay > div { margin: 0; }
#chatInfoOverlay > div[style*="padding:4px 0"] { padding-top: 6px !important; padding-bottom: 6px !important; }
#chatInfoGroupsSection { padding-top: 6px; }

/* ===== chat header icons: no circles, one size ===== */
#chat-header-bar .header-actions { gap: 2px; }
#chat-header-bar .header-icon-btn { width: 42px; height: 42px; background: none !important; border: none !important; border-radius: 0; font-size: 20px; }
#chat-header-bar .header-icon-btn i { font-size: 20px; width: 22px; text-align: center; line-height: 1; }
#chat-header-bar .header-icon-btn:active { opacity: .6; }

/* ===== typing bar: icons stay at the bottom while the text box grows ===== */
#neuralSearchBar .composer-msg-pill { align-items: flex-end; }
#neuralSearchBar .composer-input { align-self: stretch; }
#msgInput { overflow-y: auto; }

/* ===== overlays stacking (info < gallery < viewer < search/forward) ===== */
#mediaGalleryOverlay { z-index: 100060 !important; }
#chatSearchOverlay, #forwardOverlay { z-index: 100090 !important; }

/* ===== MEDIA / DOCS / LINKS ===== */
#mediaGalleryOverlay { position: fixed; inset: 0; background: #050505; flex-direction: column; }
#mediaGalleryOverlay.open { display: flex !important; }
.mg-tabs { position: relative; display: flex; flex-shrink: 0; height: calc(52px + max(env(safe-area-inset-top), 10px)); padding-top: max(env(safe-area-inset-top), 10px); box-sizing: border-box; border-bottom: 1px solid rgba(255,255,255,0.08); background: #050505; }
.mg-tab { flex: 1; display: flex; align-items: center; justify-content: center; gap: 6px; color: rgba(255,255,255,0.55); font-size: 15px; font-weight: 600; cursor: pointer; transition: color .2s; }
.mg-tab.active { color: #fff; }
.mg-ind { position: absolute; left: 0; bottom: -1px; height: 3px; width: 33.3333%; background: var(--neon-cyan); border-radius: 3px 3px 0 0; will-change: transform; }
.mg-panes { flex: 1; min-height: 0; display: flex; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; overscroll-behavior-x: contain; }
.mg-panes::-webkit-scrollbar { display: none; }
.mg-pane { flex: 0 0 100%; width: 100%; height: 100%; overflow-y: auto; overflow-x: hidden; scroll-snap-align: start; scroll-snap-stop: always; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.mg-sec { position: sticky; top: 0; z-index: 2; background: rgba(5,5,5,0.94); color: rgba(255,255,255,0.6); font-size: 12.5px; font-weight: 700; letter-spacing: .6px; text-transform: uppercase; padding: 14px 14px 8px; }
.mg-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px; }
.mg-tile { position: relative; aspect-ratio: 1; background: #111; overflow: hidden; cursor: pointer; }
.mg-tile img, .mg-tile video { width: 100%; height: 100%; object-fit: cover; display: block; pointer-events: none; opacity: 0; transition: opacity .25s; }
.mg-tile img.ready, .mg-tile video.ready { opacity: 1; }
.mg-tile:active { filter: brightness(.8); }
.mg-vid { position: absolute; left: 6px; bottom: 5px; display: flex; align-items: center; gap: 5px; color: #fff; font-size: 12px; font-weight: 600; text-shadow: 0 0 4px rgba(0,0,0,0.9); }
.mg-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; height: 60%; color: rgba(255,255,255,0.4); font-size: 14px; text-align: center; padding: 20px; }
.mg-empty i { font-size: 34px; opacity: .6; }
.mg-row { display: flex; align-items: center; gap: 14px; padding: 12px 16px; cursor: pointer; }
.mg-row:active { background: rgba(255,255,255,0.05); }
.mg-ico { width: 46px; height: 46px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 11px; font-weight: 800; color: #fff; letter-spacing: .4px; }
.mg-rt { min-width: 0; flex: 1; }
.mg-rn { color: #fff; font-size: 15.5px; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mg-rm { color: rgba(255,255,255,0.5); font-size: 13px; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.mg-rs { color: rgba(255,255,255,0.7); font-size: 13px; margin-top: 3px; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; word-break: break-word; }

/* ===== immersive viewer (same look as group.html's #mediaViewer) ===== */
.nxv-menu { position: absolute; top: 60px; right: 8px; z-index: 9; min-width: 224px; width: max-content; background: rgba(245,245,247,0.35); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.12); border-radius: 14px; padding: 6px; box-shadow: 0 8px 24px rgba(0,0,0,0.3); display: flex; flex-direction: column; transform-origin: top right; animation: nxvPop .16s ease; }
@keyframes nxvPop { from { opacity: 0; transform: scale(.92) translateY(-6px); } to { opacity: 1; transform: scale(1) translateY(0); } }
.nxv-item { display: flex; align-items: center; gap: 12px; padding: 8px 12px; border-radius: 10px; font-size: .875rem; font-weight: 550; font-family: 'Inter', sans-serif; color: rgba(0,0,0,0.85); cursor: pointer; white-space: nowrap; }
.nxv-item i { width: 20px; text-align: center; font-size: 16px; opacity: .8; color: rgba(0,0,0,0.7); flex-shrink: 0; }
.nxv-item:active { background: rgba(0,0,0,0.05); }
.nxv-item.danger, .nxv-item.danger i { color: #ff4d6d; }
.nxv-div { height: 1px; background: rgba(0,0,0,0.08); margin: 4px 0; }
body.ci-info-open .input-area.in-viewer { display: flex !important; }
.input-area.in-viewer { z-index: 6 !important; }

/* ===== immersive viewer: nothing above the typing bar (the reply target is still attached silently) ===== */
.input-area.in-viewer .reply-composer-bar { display: none !important; }

/* ============================================================
   STARRED MESSAGES + NOTIFICATIONS pages (opened from the contact-info page)
   ============================================================ */
#starredOverlay, #notifOverlay { position: fixed; inset: 0; background: #050505; z-index: 100060; flex-direction: column; font-family: 'Inter', sans-serif; }
#starredOverlay.open, #notifOverlay.open { display: flex !important; }
.st-top, .nt-top { flex-shrink: 0; display: flex; align-items: center; gap: 4px; height: calc(58px + env(safe-area-inset-top)); padding: env(safe-area-inset-top) 6px 0 6px; box-sizing: border-box; background: #0a0a0a; border-bottom: 1px solid rgba(255,255,255,0.07); }
.st-back { width: 40px; height: 44px; display: flex; align-items: center; justify-content: center; cursor: pointer; flex-shrink: 0; }
.st-title { flex: 1; color: #fff; font-size: 20px; font-weight: 400; padding-left: 10px; white-space: nowrap; }
.st-ico { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; color: #fff; font-size: 18px; cursor: pointer; flex-shrink: 0; }
.st-search-wrap { display: none; flex: 1; min-width: 0; }
.st-search-wrap input { width: 100%; height: 40px; background: transparent; border: 0; outline: 0; color: #fff; font-size: 17px; font-family: inherit; }
#starredOverlay.st-searching .st-title { display: none; }
#starredOverlay.st-searching .st-search-wrap { display: block; }
.st-menu { display: none; position: absolute; top: calc(52px + env(safe-area-inset-top)); right: 10px; z-index: 5; background: #1c1c1e; border-radius: 12px; box-shadow: 0 10px 30px rgba(0,0,0,0.6); min-width: 180px; padding: 6px 0; }
.st-menu.show { display: block; }
.st-menu div { padding: 13px 20px; color: #fff; font-size: 16px; cursor: pointer; }
.st-menu div:active { background: rgba(255,255,255,0.07); }
.st-list { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
.st-item { position: relative; padding: 11px 14px 6px 8px; cursor: pointer; }
/* no divider lines between starred items */

.st-head { display: flex; align-items: center; gap: 9px; min-width: 0; }
.st-av { position: relative; width: 26px; height: 26px; padding: 1.24px; border-radius: 50%; background: linear-gradient(135deg, #fde08d, #b8860b); box-sizing: border-box; flex-shrink: 0; }
.st-av img { display: block; width: 100%; height: 100%; box-sizing: content-box; border: 1.24px solid #050505; border-radius: 50%; background: #262626; object-fit: cover; }
.st-names { flex: 1; min-width: 0; display: flex; align-items: center; gap: 5px; color: #fff; font-size: 13.5px; font-weight: 600; white-space: nowrap; overflow: hidden; }
.st-names .nm { overflow: hidden; text-overflow: ellipsis; max-width: 42%; }
.st-names svg { width: 6px; height: 8px; flex-shrink: 0; }
.st-date { color: rgba(255,255,255,0.5); font-size: 11.5px; flex-shrink: 0; }
.st-chev { color: rgba(255,255,255,0.45); width: 6px; height: 10px; flex-shrink: 0; margin-left: 4px; }
.st-bubble { margin: 5px 0 0 35px; pointer-events: none; }
.st-bubble .message-row { padding: 0 !important; margin: 0 !important; display: block !important; }
.st-bubble .msg-row { display: inline-flex !important; flex-direction: row !important; align-self: flex-start !important; justify-content: flex-start !important; padding: 0 !important; margin: 0 !important; width: auto !important; max-width: 100% !important; }
.st-bubble .msg-row .msg-card { max-width: 100% !important; }
.st-bubble .msg-avatar { display: none !important; }
.st-empty { display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 90px 40px 0; color: rgba(255,255,255,0.5); font-size: 15px; line-height: 1.5; gap: 14px; }
.st-empty i { font-size: 42px; color: rgba(253,224,141,0.55); }

/* ---- Notifications (flat, Telegram sizes, brand colour) ---- */
:root { --nx-brand: #886A47; }
.nt-top { background: transparent !important; border-bottom: 0 !important; }
.nt-body { flex: 1; min-height: 0; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; padding: 0 0 calc(30px + env(safe-area-inset-bottom)); }
.nt-sec { color: var(--nx-brand); font-size: 15px; font-weight: 600; padding: 22px 20px 6px; }
.nt-row { display: flex; align-items: center; gap: 16px; padding: 8px 20px; min-height: 52px; box-sizing: border-box; cursor: pointer; }
.nt-row:active { background: rgba(255,255,255,0.04); }
.nt-lbl { flex: 1; min-width: 0; }
.nt-lbl b { display: block; color: #fff; font-size: 16px; font-weight: 400; line-height: 1.3; }
.nt-lbl small { display: block; color: rgba(255,255,255,0.5); font-size: 13px; line-height: 1.35; margin-top: 1px; }
.nt-val { color: var(--nx-brand); font-size: 16px; flex-shrink: 0; }
.nt-switch { position: relative; width: 36px; height: 20px; border-radius: 10px; background: #3a3a3c; flex-shrink: 0; transition: background .18s; }
.nt-switch::after { content: ''; position: absolute; top: 2px; left: 2px; width: 16px; height: 16px; border-radius: 50%; background: #fff; transition: transform .18s; }
.nt-switch.on { background: var(--nx-brand); }
.nt-switch.on::after { transform: translateX(16px); }

.nt-top .st-title { font-size: 20px; }

/* star sits next to the time, same colour as the time (WhatsApp) */
.msg-star-inline { margin-right: 3px; vertical-align: -1px; opacity: .95; }
/* jumping to a message: soft white wash over the whole row that fades out (WhatsApp) */
@keyframes nxHl { 0%, 55% { background: rgba(255,255,255,0.16); } 100% { background: rgba(255,255,255,0); } }
.message-row.nx-hl { animation: nxHl 1.6s ease-out; }
