<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, interactive-widget=resizes-content">
<meta name="theme-color" content="#050505">
<title>Channel - Nexus</title>
<link rel="stylesheet" href="channels.css">
</head>
<body>
    <div id="page-content">
    <header>
        <div class="back-trigger" data-spa-link="chats.html" aria-label="Back">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M11 17l-5-5 5-5M18 12H6"/></svg>
        </div>
        <div class="channel-avatar" id="headerAvatar" data-act="info"></div>
        <div class="channel-meta" data-act="info">
            <h1 id="headerName"><span class="nm">Channel</span></h1>
            <p id="headerSubCount">&nbsp;</p>
        </div>
        <button class="header-icon-btn" id="searchIconBtn" data-act="search" aria-label="Search">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.35-4.35"/></svg>
        </button>
        <button class="menu-icon" data-act="menu" aria-label="More options">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2"><circle cx="12" cy="12" r="1"/><circle cx="12" cy="5" r="1"/><circle cx="12" cy="19" r="1"/></svg>
        </button>
    </header>

    <div class="ch-pin" id="pinBar" data-act="gotoPin" hidden></div>

    <main class="feed" id="feedContainer"></main>

    <div id="bottomBar"></div>

    <button id="toLatest" data-act="toLatest" aria-label="Jump to latest">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg><em id="toLatestN"></em>
    </button>

    <input type="file" id="chFile" hidden>

    <div id="chSheetWrap"><div id="chSheetBg"></div><div id="chSheet"></div></div>

    <div class="ch-ov" id="chSearch">
        <div class="ch-ov-top">
            <div class="bk" data-act="back" aria-label="Close search"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2.5"><path d="M11 17l-5-5 5-5M18 12H6"/></svg></div>
            <input id="chSearchInput" type="search" placeholder="Search this channel" autocomplete="off" enterkeyhint="search">
        </div>
        <div class="ch-ov-body" id="chSearchBody"></div>
    </div>

    <div class="ch-ov" id="chLight"></div>

    <div id="chToast"></div>
    </div>

<script src="router.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-firestore-compat.js"></script>
<script src="channels.js"></script>

</body>
</html>
